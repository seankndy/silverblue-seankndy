# Disabled: only enabled explicitly for the Containerfile install, so
# rpm-ostree on the running system never consults it. grok-bot's install
# script rewrites this file but keeps enabled=0.
[grok-bot]
name=Grok Bot
baseurl=https://downloads.cursor.com/yumrepo/grok-bot
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-anysphere-380FF4BCDC34A4BD92A3565342A1772E62E492D6.asc
skip_if_unavailable=1
