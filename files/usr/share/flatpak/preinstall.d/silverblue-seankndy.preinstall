# System Flatpaks for this image, installed from Flathub by `sync-flatpaks`.
# Removing an entry here uninstalls the app on the next sync; apps you
# uninstall yourself are not reinstalled. Format: flatpak-preinstall(1).
# Every entry needs Branch=stable and CollectionID=org.flathub.Stable, so
# it comes from Flathub even when Fedora's remote has the same app.

# 1Password
[Flatpak Preinstall com.onepassword.OnePassword]
Branch=stable
CollectionID=org.flathub.Stable

# Cartero
[Flatpak Preinstall es.danirod.Cartero]
Branch=stable
CollectionID=org.flathub.Stable

